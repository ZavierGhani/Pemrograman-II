<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controller.PelangganController">

    <top>
        <GridPane hgap="10" vgap="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

            <Label text="Nama"/>
            <TextField fx:id="txtNama" GridPane.columnIndex="1"/>

            <Label text="Email" GridPane.rowIndex="1"/>
            <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Telepon" GridPane.rowIndex="2"/>
            <TextField fx:id="txtTelepon" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <HBox spacing="10" GridPane.rowIndex="3" GridPane.columnIndex="1">
                <Button text="Tambah" onAction="#tambahPelanggan"/>
                <Button text="Update" onAction="#updatePelanggan"/>
                <Button text="Hapus" onAction="#hapusPelanggan"/>
            </HBox>
        </GridPane>
    </top>

    <center>
        <TableView fx:id="tablePelanggan">
            <columns>
                <TableColumn fx:id="colId" text="ID"/>
                <TableColumn fx:id="colNama" text="Nama"/>
                <TableColumn fx:id="colEmail" text="Email"/>
                <TableColumn fx:id="colTelepon" text="Telepon"/>
            </columns>
        </TableView>
    </center>

</BorderPane>

